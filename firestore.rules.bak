rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner() {
      return request.auth != null && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    match /products/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{docId} {
      allow create: if true; // customers can create orders
      allow read: if true;
      allow update: if isAdmin();
      allow delete: if isOwner();
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // manage via console or Admin-only server
    }
  }
}
