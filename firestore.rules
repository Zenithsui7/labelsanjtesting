rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner() {
      return request.auth != null && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'owner';
    }

    match /products/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{docId} {
      allow create: if true; // customers can create orders
      allow read: if true;
      allow update: if isAdmin();
      allow delete: if isOwner();
    }

    // Relaxed admins rule: allow authenticated users to create their own admin doc
    // This permits the first sign-in to bootstrap an owner client-side.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }
  }
}
